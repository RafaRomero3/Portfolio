---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { perfil } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rafael Romero — Desenvolvedor de software',
  description = perfil.bio,
} = Astro.props;

// redes sociais só aceitam endereço completo, que depende de `site` no astro.config.mjs
const urlDaPagina = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const imagem = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {urlDaPagina && <link rel="canonical" href={urlDaPagina} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {urlDaPagina && <meta property="og:url" content={urlDaPagina} />}
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rafael Romero, desenvolvedor de software" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="topo">
    <slot />
  </body>
</html>
