---
// Fontes instaladas pelo npm (ficam no seu próprio site, sem depender do Google)
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';

// Cores, fontes e ajustes básicos
import '../styles/global.css';

// As "props": informações que cada página pode passar para o layout
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rafael — Desenvolvedor de software',
  description = 'Portfólio de Rafael, desenvolvedor de software.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- O conteúdo de cada página entra aqui -->
    <slot />
  </body>
</html>
