---
import { perfil } from '../data/site';
---

<aside class="sidebar" aria-label="Perfil">
  <div class="identidade">
    <h1>{perfil.nome} <span class="sobrenome">{perfil.sobrenome}</span></h1>
    <p class="linha">
      <strong>{perfil.cargo}</strong> · {perfil.empresa} · {perfil.cidade}
    </p>
  </div>

  {perfil.disponivel && (
    <p class="selo">
      <span class="bolinha" aria-hidden="true"></span>
      Aberto a novas oportunidades
    </p>
  )}

  <p class="bio">
    {perfil.bio} 
  </p>

  <div class="botoes">
    <a href={perfil.links.curriculo} class="botao botao-destaque">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 21h14"></path></svg>
      Baixar currículo
    </a>
    <a href={perfil.links.linkedin} class="botao" target="_blank" rel="noopener">LinkedIn</a>
    <a href={perfil.links.github} class="botao" target="_blank" rel="noopener">GitHub</a>
  </div>

  <figure class="cartao" aria-label="Resumo">
    <div class="cartao-topo" aria-hidden="true">
      <span></span><span></span><span></span>
      <code>rafael.json</code>
    </div>
    <dl>
      {perfil.resumo.map((item) => (
        <div class="linha-json">
          <dt>{item.chave}</dt>
          <dd>"{item.valor}"</dd>
        </div>
      ))}
    </dl>
  </figure>

  <div class="cartao api" aria-hidden="true">
    <div class="cartao-topo">
      <span></span><span></span><span></span>
      <code>api.rafael.dev</code>
    </div>
    <div class="api-corpo">
      <p class="api-requisicao">
        <span class="api-metodo">GET</span>
        <span class="api-rota"></span>
      </p>
      <p class="api-resposta">
        <span class="api-status">···</span>
        <span class="api-detalhe"></span>
      </p>
      <div class="api-progresso">
        <div class="api-trilho"><div class="api-barra"></div></div>
        <span class="api-contador">00 / 00</span>
      </div>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    padding: 40px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* evita que os blocos encolham quando a coluna fixa tem altura limitada */
  .sidebar > * {
    flex-shrink: 0;
  }

  .identidade {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .sobrenome {
    color: var(--text-dim);
  }

  .linha {
    color: var(--text-muted);
  }

  .linha strong {
    color: var(--text);
    font-weight: 600;
  }

  .selo {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-soft);
  }

  .bolinha {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .bolinha::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent);
    animation: pulso 2s ease-out infinite;
  }

  @keyframes pulso {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bolinha::after,
    .api-rota::after {
      animation: none;
    }
  }

  .bio {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.5;
  }


  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cartao {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .cartao-topo {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
  }

  .cartao-topo span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--line-strong);
    transition: background 0.2s;
  }

  .cartao:hover .cartao-topo span:nth-child(1) {
    background: var(--dot-red);
  }

  .cartao:hover .cartao-topo span:nth-child(2) {
    background: var(--dot-yellow);
  }

  .cartao:hover .cartao-topo span:nth-child(3) {
    background: var(--dot-green);
  }

  .cartao-topo code {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  .cartao dl {
    padding: 8px 16px 10px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .linha-json {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 3px 0;
  }

  .linha-json dt {
    color: var(--text-dim);
  }

  .linha-json dd {
    color: var(--accent);
    text-align: right;
  }

  .api {
    display: none;
  }

  .api-corpo {
    display: grid;
    gap: 10px;
    padding: 14px 16px 16px;
    font-family: var(--font-mono);
  }

  .api-requisicao {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
    font-size: 15px;
    white-space: nowrap;
  }

  .api-metodo {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 12px;
    font-weight: 600;
  }

  .api-rota::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -3px;
    background: var(--accent);
    animation: piscar 1s steps(1) infinite;
  }

  @keyframes piscar {
    50% {
      opacity: 0;
    }
  }

  .api-resposta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
  }

  .api-status {
    color: var(--accent);
    transition: color 0.2s;
  }

  .api.carregando .api-status {
    color: var(--text-dim);
  }

  .api-detalhe {
    color: var(--text-dim);
    text-align: right;
  }

  .api-progresso {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .api-trilho {
    flex: 1;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .api-barra {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  @media (min-width: 960px) {
    .sidebar {
      position: sticky;
      top: var(--header-h);
      height: calc(100vh - var(--header-h));
      overflow-y: auto;
      scrollbar-width: none;
      padding: clamp(16px, 4vh, 40px) 0 clamp(28px, 5vh, 56px);
      gap: clamp(10px, 2vh, 18px);
    }

    .sidebar::-webkit-scrollbar {
      display: none;
    }

    h1 {
      font-size: clamp(32px, 5.5vh, 44px);
    }

    .api {
      display: block;
      margin-top: auto;
    }
  }

  @media (min-width: 960px) and (max-height: 800px) {
    .sidebar {
      padding: 16px 0 24px;
      gap: 10px;
    }

    .identidade {
      gap: 4px;
    }

    .selo {
      padding: 3px 12px;
    }

    .botao {
      height: 40px;
    }

    .cartao-topo {
      padding: 6px 14px;
    }

    .linha-json {
      padding: 2px 0;
    }

    .api-corpo {
      gap: 8px;
      padding: 10px 16px 12px;
    }
  }

  /* o rafael.json repete empresa, cargo e cidade, que já aparecem no topo */
  @media (min-width: 960px) and (max-height: 675px) {
    .cartao:not(.api) {
      display: none;
    }
  }
</style>

<script>
  const painel = document.querySelector<HTMLElement>('.api');
  const passos = Array.from(document.querySelectorAll<HTMLElement>('[data-endpoint]'));
  const reduzirMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (painel && passos.length > 0) {
    const metodo = painel.querySelector<HTMLElement>('.api-metodo')!;
    const rota = painel.querySelector<HTMLElement>('.api-rota')!;
    const status = painel.querySelector<HTMLElement>('.api-status')!;
    const detalhe = painel.querySelector<HTMLElement>('.api-detalhe')!;
    const contador = painel.querySelector<HTMLElement>('.api-contador')!;
    const barra = painel.querySelector<HTMLElement>('.api-barra')!;

    const total = String(passos.length).padStart(2, '0');
    let atual = -1;
    let timer: number | undefined;

    const responder = (passo: HTMLElement) => {
      painel.classList.remove('carregando');
      status.textContent = passo.dataset.status ?? '200 OK';
      detalhe.textContent = passo.dataset.detalhe ?? '';
    };

    const digitar = (caminho: string, passo: HTMLElement, letras: number) => {
      rota.textContent = caminho.slice(0, letras);
      if (letras < caminho.length) {
        timer = window.setTimeout(() => digitar(caminho, passo, letras + 1), 30);
      } else {
        timer = window.setTimeout(() => responder(passo), 200);
      }
    };

    const mostrar = (indice: number) => {
      if (indice === atual) return;
      atual = indice;

      const passo = passos[indice];
      const [verbo, caminho] = passo.dataset.endpoint!.split(' ');

      passos.forEach((p, i) => p.classList.toggle('ativo', i === indice));
      metodo.textContent = verbo;
      contador.textContent = `${String(indice + 1).padStart(2, '0')} / ${total}`;
      barra.style.transform = `scaleX(${(indice + 1) / passos.length})`;

      clearTimeout(timer);

      if (reduzirMovimento) {
        rota.textContent = caminho;
        responder(passo);
        return;
      }

      painel.classList.add('carregando');
      status.textContent = '···';
      detalhe.textContent = '';

      // mantém o trecho igual ao da rota anterior e digita só o resto
      const anterior = rota.textContent ?? '';
      let comum = 0;
      while (comum < anterior.length && anterior[comum] === caminho[comum]) comum++;
      digitar(caminho, passo, comum);
    };

    const atualizar = () => {
      const meioDaTela = window.innerHeight * 0.5;
      // no fim da página, o último passo pode nunca chegar ao meio da tela
      const noFim = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;

      let indice = 0;
      passos.forEach((passo, i) => {
        if (passo.getBoundingClientRect().top <= meioDaTela) indice = i;
      });

      mostrar(noFim ? passos.length - 1 : indice);
    };

    window.addEventListener('scroll', atualizar, { passive: true });
    atualizar();
  }
</script>