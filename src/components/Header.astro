---
import { perfil } from '../data/site';
---

<header class="header">
  <nav class="nav" aria-label="Principal">
    <a href="#topo" class="marca">
      <span class="logo">rafael<span class="ponto">.</span>dev</span>
      <span class="papel">{perfil.cargo}</span>
    </a>

    <div class="links">
      <a href="#projetos">Projetos</a>
      <a href={perfil.links.github} class="so-desktop" target="_blank" rel="noopener">GitHub</a>
      <a href={perfil.links.linkedin} class="so-desktop" target="_blank" rel="noopener">LinkedIn</a>
      <a href={perfil.links.curriculo} class="cta">Currículo</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .nav {
    max-width: var(--max-width);
    min-height: var(--header-h);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .marca {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .ponto {
    color: var(--accent);
  }

  .papel {
    display: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .links a {
    padding: 12px;
    font-size: 15px;
    color: var(--text-soft);
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--text);
  }

  .links .cta {
    margin-left: 8px;
    padding: 10px 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .links .cta:hover {
    color: var(--accent-ink);
    opacity: 0.9;
  }

  /* no celular, GitHub e LinkedIn já aparecem na Sidebar */
  .links .so-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .papel {
      display: inline;
    }

    .links .so-desktop {
      display: inline;
    }
  }
</style>