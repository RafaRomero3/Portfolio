---
import { stack } from '../data/stack';

const total = stack.flatMap((grupo) => grupo.itens).length;
---

<section id="stack" class="secao" data-section="Stack">
  <div class="secao-topo">
    <h2>Stack</h2>
    <p class="secao-meta">{stack.length} grupos · {total} tecnologias</p>
  </div>

  <dl class="grupos">
    {stack.map((grupo) => (
      <div class="grupo">
        <dt>{grupo.nome}</dt>
        <dd>
          <ul class="itens">
            {grupo.itens.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .grupos {
    border-top: 1px solid var(--line);
  }

  .grupo {
    display: grid;
    gap: 10px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .itens {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .itens li {
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-soft);
  }

  @media (min-width: 640px) {
    .grupo {
      grid-template-columns: 200px 1fr;
      align-items: baseline;
    }
  }
</style>
