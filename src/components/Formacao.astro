---
import { formacoes, idiomas } from '../data/formacao';
import { formatarPeriodo } from '../utils/datas';
---

<section id="formacao" class="secao">
  <div class="secao-topo">
    <h2>Formação & idiomas</h2>
  </div>

  <ul class="lista">
    {formacoes.map((item) => (
      <li
        class="cartao"
        data-endpoint={`GET /formacao/${item.slug}`}
        data-detalhe={formatarPeriodo(item.inicio, item.fim)}
      >
        <p class="periodo">{formatarPeriodo(item.inicio, item.fim)}</p>
        <h3>{item.curso}</h3>
        <p class="detalhe">{item.instituicao} · {item.local}</p>
      </li>
    ))}
  </ul>

  <h3 class="subtitulo">Idiomas</h3>
<ul class="idiomas">
  {idiomas.map((idioma) => (
    <li class="idioma">
      <span class="sigla" aria-hidden="true">{idioma.sigla}</span>
      <div>
        <p class="nome">{idioma.nome}</p>
        <p class="nivel">{idioma.nivel}</p>
      </div>
      <span class="medidor" role="img" aria-label={`Nível ${idioma.proficiencia} de 5`}>
        {Array.from({ length: 5 }, (_, i) => <span class:list={{ cheio: i < idioma.proficiencia }} />)}
      </span>
    </li>
  ))}
</ul>
</section>

<style>
  .lista {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .cartao {
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .periodo,
  .subtitulo,
  .nivel {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .cartao h3 {
    margin-top: 8px;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 600;
  }

  .detalhe {
    margin-top: 4px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .subtitulo {
    margin: 32px 0 12px;
    font-weight: 400;
  }

  .idiomas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .idioma {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px 14px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .sigla {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
  }

  .nome {
    font-size: 17px;
    font-weight: 600;
  }

  .medidor {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }

  .medidor span {
    height: 6px;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .medidor .cheio {
    background: var(--accent);
  }

</style>
