---
import { formacoes, idiomas } from '../data/formacao';
import { formatarPeriodo } from '../utils/datas';
---

<section id="formacao" class="secao" data-section="Formação">
  <div class="secao-topo">
    <h2>Formação & idiomas</h2>
  </div>

  <ul class="lista">
    {formacoes.map((item) => (
      <li class="cartao" data-year={item.inicio.slice(0, 4)}>
        <p class="periodo">{formatarPeriodo(item.inicio, item.fim)}</p>
        <h3>{item.curso}</h3>
        <p class="detalhe">{item.instituicao} · {item.local}</p>
      </li>
    ))}
  </ul>

  <h3 class="subtitulo">Idiomas</h3>
  <dl class="idiomas">
    {idiomas.map((idioma) => (
      <div class="idioma">
        <dt>{idioma.nome}</dt>
        <dd>{idioma.nivel}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .lista {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .cartao {
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .periodo,
  .subtitulo,
  .idioma dd {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .cartao h3 {
    margin-top: 8px;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 600;
  }

  .detalhe {
    margin-top: 4px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .subtitulo {
    margin: 32px 0 12px;
    font-weight: 400;
  }

  .idiomas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .idioma {
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .idioma dt {
    font-weight: 500;
  }
</style>
