---
import { perfil } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="interno">
    <p>© {ano} {perfil.nome} {perfil.sobrenome}</p>
    <p>
      Feito com Astro · <a href="https://github.com/RafaRomero3/portfolio" target="_blank" rel="noopener">ver código ↗</a>
    </p>
    <a href="#topo" class="topo">Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--line);
  }

  .interno {
    display: grid;
    justify-items: center;
    gap: 16px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 28px 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-align: center;
  }

  a {
    color: var(--text-soft);
    transition: color 0.2s, border-color 0.2s;
  }

  a:hover {
    color: var(--text);
  }

  .topo {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  .topo:hover {
    border-color: var(--text-dim);
  }

  @media (min-width: 640px) {
    .interno {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .interno > :first-child {
      justify-self: start;
    }

    .topo {
      justify-self: end;
    }
  }
</style>
