---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Experiencia from "../components/Experiencia.astro";
import Stack from "../components/Stack.astro";
import Formacao from "../components/Formacao.astro";
import Contato from "../components/Contato.astro";
import Rodape from "../components/Rodape.astro";
---

<Layout>
  <Header />

  <div class="colunas">
    <Sidebar />

    <main class="conteudo">
      <Experiencia />
      <Stack />
      <Formacao />
      <Contato />
    </main>
  </div>
  <Rodape />
</Layout>

<style>
  .colunas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
  }

  .conteudo {
    min-width: 0;
    padding-bottom: 64px;
  }

  @media (min-width: 960px) {
    .colunas {
      grid-template-columns: 360px minmax(0, 1fr);
      gap: 72px;
      align-items: start; /* sem isso o sticky da Sidebar não funciona */
    }
  }
</style>
