---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

// provisório: só para testar a rolagem
const secoes = [
  { id: 'experiencia', titulo: 'Experiência' },
  { id: 'projetos', titulo: 'Projetos' },
  { id: 'stack', titulo: 'Stack' },
  { id: 'formacao', titulo: 'Formação & certificações' },
  { id: 'contato', titulo: 'Contato' },
];
---

<Layout>
  <Header />

  <div class="colunas">
    <Sidebar />

    <main class="conteudo">
      {secoes.map((secao) => (
        <section id={secao.id} class="secao">
          <h2>{secao.titulo}</h2>
          <div class="provisorio">Conteúdo da seção (Fase 4)</div>
        </section>
      ))}
    </main>
  </div>
</Layout>

<style>
  .colunas {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
  }

  .conteudo {
    min-width: 0;
    padding-bottom: 64px;
  }

  .secao {
    padding-top: 48px;
  }

  h2 {
    font-size: 30px;
    letter-spacing: -0.025em;
    font-weight: 600;
    padding-bottom: 20px;
  }

  .provisorio {
    height: 520px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
  }

  @media (min-width: 960px) {
    .colunas {
      grid-template-columns: 360px minmax(0, 1fr);
      gap: 72px;
      align-items: start; /* sem isso o sticky da Sidebar não funciona */
    }
  }
</style>